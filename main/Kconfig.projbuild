menu "Relay Wi-Fi Configuration"

    config RELAY_WIFI_SSID
        string "Wi-Fi network name (SSID)"
        default ""
        help
            Name of the Wi-Fi network the ESP32 should join.

    config RELAY_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Password for the Wi-Fi network.

    config RELAY_CONTROL_PASSWORD
        string "Relay HTTP password (12 to 64 characters)"
        default ""
        help
            Password required in the X-Relay-Password request header.

    config RELAY_PULSE_MIN_MS
        int "Minimum relay pulse (milliseconds)"
        range 1 30000
        default 100
        help
            Shortest relay pulse duration accepted by the HTTP endpoint.

    config RELAY_PULSE_MAX_MS
        int "Maximum relay pulse (milliseconds)"
        range 1 30000
        default 2000
        help
            Longest relay pulse duration accepted by the HTTP endpoint.

endmenu